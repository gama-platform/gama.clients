{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2017",
    "lib": ["es2017", "dom"],
    "moduleDetection": "auto",

    /* Modules */
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["jest"],
    /* Source files import each other with a .ts extension; legal only because tsc never
       emits here — tsup owns the build. */
    "allowImportingTsExtensions": true,

    /* Emit */
    "noEmit": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Completeness */
    "skipLibCheck": true
  },
  "include": ["src", "tests", "jest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
